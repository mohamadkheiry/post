{
  "Api": {
    "AuthenticationEnabled": true,
    "SwaggerEnabled": false,
    "MetricsEnabled": true
  },
  "Auth": {
    "Issuer": "post-core-identity",
    "Audience": "post-platform",
    "SigningKey": "",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Edge": {
    "Integrations": {
      "Profile": "Mock"
    },
    "Storage": {
      "ConnectionString": "Data Source=edge.db",
      "ApplyMigrationsOnStartup": true,
      "MinimumAvailableDiskBytes": 536870912,
      "EncryptionEnabled": false,
      "EncryptionKeyEnvironmentVariable": "POST_EDGE_SQLITE_KEY",
      "PreviousEncryptionKeyEnvironmentVariable": "POST_EDGE_SQLITE_PREVIOUS_KEY",
      "BackupDirectory": "edge-backups"
    },
    "Security": {
      "AllowUnboundDevices": false
    },
    "LocalAdmin": {
      "AuthenticationEnabled": true,
      "InitialUserName": "admin",
      "SessionLifetime": "00:30:00",
      "LoginPermitLimit": 5,
      "LoginRateWindow": "00:01:00",
      "MaximumRequestBodyBytes": 4096
    },
    "Resilience": {
      "HttpMaxRetryAttempts": 2,
      "HttpRetryBaseDelay": "00:00:00.200",
      "HttpAttemptTimeout": "00:00:05",
      "HttpCircuitFailureRatio": 0.5,
      "HttpCircuitMinimumThroughput": 8,
      "HttpCircuitSamplingDuration": "00:00:30",
      "HttpCircuitBreakDuration": "00:00:15",
      "SqlMaxRetryAttempts": 2,
      "SqlRetryBaseDelay": "00:00:00.200",
      "SqlCircuitFailureThreshold": 4,
      "SqlCircuitBreakDuration": "00:00:15"
    },
    "DestinationApi": {
      "RequestTimeout": "00:00:10",
      "MaximumResponseBytes": 1048576
    },
    "CoreApi": {
      "RequestTimeout": "00:00:15",
      "MaximumResponseBytes": 8388608
    },
    "PostalSql": {
      "CommandTimeoutSeconds": 30
    },
    "PostalSoap": {
      "RequestTimeout": "00:00:10",
      "MaximumResponseCharacters": 1048576
    },
    "DeviceTransport": {
      "MaximumReceiveMessageSizeBytes": 201326592,
      "ConnectionPermitLimit": 20,
      "ConnectionRateWindow": "00:01:00",
      "AuthenticationDeadline": "00:00:10",
      "FailedAuthenticationCloseDelay": "00:00:00.100"
    },
    "Workers": {
      "BatchSize": 50,
      "MaxOutboxAttempts": 8,
      "PollInterval": "00:00:02",
      "CleanupEnabled": false,
      "CleanupInterval": "01:00:00",
      "RetentionPeriod": "30.00:00:00",
      "IdempotencyRetentionPeriod": "90.00:00:00"
    },
    "Mock": {
      "CenterCode": "59544",
      "ConfigurationVersion": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*"
}
