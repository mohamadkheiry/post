{
  "Api": {
    "AuthenticationEnabled": true,
    "SwaggerEnabled": true,
    "MetricsEnabled": false
  },
  "Auth": {
    "Issuer": "post-core-identity-development",
    "Audience": "post-platform-development",
    "SigningKey": "development-only-post-platform-signing-key-change-me",
    "RequireHttpsMetadata": false
  },
  "Core": {
    "Database": {
      "Provider": "Sqlite",
      "Directory": "data/core/edge-health",
      "ApplyMigrations": false
    },
    "Outbox": {
      "Enabled": false
    }
  }
}
