{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Core": {
    "PendingAttachments": {
      "PollingSeconds": 30,
      "BaseRetrySeconds": 5,
      "MaximumRetrySeconds": 300,
      "MaximumAttempts": 10,
      "MaximumAgeHours": 24,
      "BatchSize": 50,
      "DeadLetterTopic": "image.metadata.pending.dlq"
    }
  },
  "AllowedHosts": "*"
}
