{
  "Api": {
    "AuthenticationEnabled": false,
    "SwaggerEnabled": true,
    "MetricsEnabled": true
  },
  "Edge": {
    "Integrations": {
      "Profile": "Mock"
    },
    "Storage": {
      "ConnectionString": "Data Source=edge.development.db",
      "ApplyMigrationsOnStartup": true
    },
    "Security": {
      "AllowUnboundDevices": true
    },
    "Mock": {
      "CenterCode": "59544",
      "ConfigurationVersion": 1,
      "Devices": [
        {
          "DeviceId": "mock-device",
          "LogicalId": "MOCK-01",
          "Token": "local-development-token-change-me",
          "IsActive": true
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  }
}
