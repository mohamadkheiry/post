{
  "AllowedHosts": "*",
  "Auth": {
    "AuthenticationEnabled": true,
    "Issuer": "post-core-identity",
    "Audience": "post-platform",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30,
    "RateLimitPermitLimit": 200,
    "RateLimitTokensPerPeriod": 100,
    "RateLimitReplenishmentSeconds": 1,
    "RateLimitQueueLimit": 20
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": { "ClusterId": "identity", "Order": -100, "AuthorizationPolicy": "Anonymous", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "identity-admin-edges": { "ClusterId": "identity", "Order": -101, "Match": { "Path": "/api/admin/edges", "Methods": ["POST"] } },
      "identity-admin-edge-rotate": { "ClusterId": "identity", "Order": -101, "Match": { "Path": "/api/admin/edges/{edgeId}/rotate-secret", "Methods": ["POST"] } },
      "identity-admin-edge-disable": { "ClusterId": "identity", "Order": -101, "Match": { "Path": "/api/admin/edges/{edgeId}/disable", "Methods": ["POST"] } },
      "device-config-admin": { "ClusterId": "device-config", "Order": -90, "Match": { "Path": "/api/admin/devices/{**catch-all}" } },
      "configuration-admin": { "ClusterId": "device-config", "Order": -90, "Match": { "Path": "/api/admin/config/{**catch-all}" } },
      "configuration-edge": { "ClusterId": "device-config", "Order": -90, "Match": { "Path": "/api/edge/config/{**catch-all}" } },
      "parcel-query": { "ClusterId": "parcel-lifecycle", "Order": -80, "Match": { "Path": "/api/edge/parcels/{**catch-all}" } },
      "parcel-bags": { "ClusterId": "parcel-lifecycle", "Order": -80, "Match": { "Path": "/api/edge/bags/{**catch-all}" } },
      "parcel-dispatches": { "ClusterId": "parcel-lifecycle", "Order": -80, "Match": { "Path": "/api/edge/dispatches/{**catch-all}" } },
      "parcel-admin": { "ClusterId": "parcel-lifecycle", "Order": -70, "Match": { "Path": "/api/admin/parcels/{**catch-all}" } },
      "bags-admin": { "ClusterId": "parcel-lifecycle", "Order": -70, "Match": { "Path": "/api/admin/bags/{**catch-all}" } },
      "dispatch-admin": { "ClusterId": "parcel-lifecycle", "Order": -70, "Match": { "Path": "/api/admin/dispatches/{**catch-all}" } },
      "image-upload-url": { "ClusterId": "object-storage", "Order": -100, "Match": { "Path": "/api/edge/images/presigned-url" } },
      "edge-health-admin": { "ClusterId": "edge-health", "Order": -100, "Match": { "Path": "/api/admin/edges/health" } },
      "edge-health-registration": { "ClusterId": "edge-health", "Order": -100, "Match": { "Path": "/api/edge/registration" } },
      "edge-health-heartbeat": { "ClusterId": "edge-health", "Order": -100, "Match": { "Path": "/api/edge/heartbeat" } },
      "edge-health-events": { "ClusterId": "edge-health", "Order": -100, "Match": { "Path": "/api/edge/events" } },
      "operational-result": { "ClusterId": "operational-result", "Order": -100, "Match": { "Path": "/api/edge/operational-results" } },
      "ingestion": { "ClusterId": "data-ingestion", "Order": 0, "Match": { "Path": "/api/edge/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:7101/" } } },
      "data-ingestion": { "Destinations": { "primary": { "Address": "http://localhost:7102/" } } },
      "parcel-lifecycle": { "Destinations": { "primary": { "Address": "http://localhost:7103/" } } },
      "device-config": { "Destinations": { "primary": { "Address": "http://localhost:7104/" } } },
      "object-storage": { "Destinations": { "primary": { "Address": "http://localhost:7105/" } } },
      "edge-health": { "Destinations": { "primary": { "Address": "http://localhost:7106/" } } },
      "operational-result": { "Destinations": { "primary": { "Address": "http://localhost:7107/" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  }
}
