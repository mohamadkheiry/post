{
  "Api": {
    "AuthenticationEnabled": true,
    "SwaggerEnabled": false,
    "MetricsEnabled": false
  },
  "Auth": {
    "Issuer": "post-core-tests",
    "Audience": "post-platform-tests",
    "SigningKey": "testing-only-post-platform-signing-key-32-bytes",
    "RequireHttpsMetadata": false
  },
  "Core": {
    "Database": {
      "Provider": "Sqlite",
      "ApplyMigrations": false
    },
    "Outbox": {
      "Enabled": false
    }
  }
}
